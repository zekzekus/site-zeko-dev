;; Task runner for site-zeko-dev.
;; Run `bb tasks` to see what's available, `bb <task>` to run one.
{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.process :as p]
             [clojure.string :as str])

  serve
  {:doc "Live preview at http://127.0.0.1:1111 (with drafts)"
   :task (shell "zola serve --drafts")}

  build
  {:doc "Build site into ./public"
   :task (shell "zola build")}

  check
  {:doc "Validate internal links + anchors"
   :task (shell "zola check")}

  clean
  {:doc "Remove build output"
   :task (shell "rm -rf public")}

  deploy
  {:doc "Full edit→prod (jj-native): check, build, commit @, advance master, push"
   :task (let [bookmark "master"
               msg      (first *command-line-args*)
               ;; In jj, the working copy is always committed to @.
               ;; "empty" = no diff vs parent = nothing new to ship from @.
               empty?   (-> (p/shell {:out :string}
                              "jj" "log" "-r" "@" "--no-graph" "-T" "empty")
                            :out str/trim (= "true"))]
           (when (and (not empty?) (not msg))
             (println "✗ working copy @ has changes — provide a description:")
             (println "  bb deploy \"my message\"")
             (System/exit 1))

           (println "▸ zola check")  (shell "zola check")
           (println "▸ zola build")  (shell "zola build")

           (when-not empty?
             (println (str "▸ jj commit -m " (pr-str msg)))
             (shell "jj" "commit" "-m" msg))

           (println (str "▸ jj bookmark move " bookmark " --to @-"))
           ;; No-op if bookmark already at @-; errors if it would go backwards.
           (p/shell {:continue true}
                    "jj" "bookmark" "move" bookmark "--to" "@-")

           (println "▸ jj git push")
           (shell "jj" "git" "push")
           (println "✓ pushed — Cloudflare will deploy in ~30–60s"))}}}
